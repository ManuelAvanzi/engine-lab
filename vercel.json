{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/lab/",
      "destination": "/lab.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/account/",
      "destination": "/account.html"
    },
    {
      "source": "/fonti",
      "destination": "/fonti.html"
    },
    {
      "source": "/fonti/",
      "destination": "/fonti.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
